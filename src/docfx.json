{
  "metadata": {
    "src": [
      {
        "files": [
          "**/bin/**.dll"
        ],
        "src": "../"
      }
    ],
    "dest": "api"
  },
  "build": {
    "markdownEngineName": "markdig",
    "markdownEngineProperties": {
      "markdigExtensions": [
        "common",
        "advanced",
        "attributes",
        "footnotes",
        "nonascii-noescape",
        "globalization"
      ],
      "alerts": {
        "NOTE": "alert alert-note",
        "TIP": "alert alert-tip",
        "IMPORTANT": "alert alert-important",
        "CASESTUDY": "alert alert-casestudy",
        "CAUTION": "alert alert-caution",
        "WARNING": "alert alert-warning",
        "BETA": "alert alert-beta",
        "LEGACY": "alert alert-legacy",
        "LICENSE": "alert alert-license",
        "DIVEIN": "alert alert-divein",
        "SUBSCRIPTION": "alert alert-subscription",
        "WORKAROUND": "alert alert-workaround"
      }
    },
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "**/include/**",
          "**/includes/**",
          "doc_modules/**",
          "_site/**",
          "_shared/**",
          "_templates/**",
          "_themes/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "**.bmp",
          "**.gif",
          "**.jpg",
          "**.svg",
          "**.png",
          "**.pdf"
        ],
        "exclude": [
          "**.htm",
          "**.py",
          "**.html",
          "**.xml",
          "stale",
          "_site/**",
          "_shared/**",
          "_templates/**",
          "_themes/**"
        ]
      }
    ],
    "output": "..\\docset-build\\api",
    "globalMetadataFiles": [
      "global_metadata.json"
    ],
    "fileMetadataFiles": [],
    "template": [
      "_themes"
    ],
    "postProcessors": [],
    "noLangKeyword": false,
    "keepFileLink": false,
    "disableGitFeatures": true,
    "sitemap": {
      "baseUrl": "https://_baseurl_"
    },
    "globalMetadata": {
      "_appFaviconPath": "favicon.ico",
      "_disableNewTab": "true",
      "_disableNextArticle": "true",
      "_noindex": "false",
      "searchProduct": "arcgis-pro-net",
      "searchVersion": "3.7",
      "_appFooter": "Copyright © 2026 Esri",
      "_lang": "en",
      "searchMode": "remote",
      "buildType": "web-help",
      "envTier": "local"
    }
  }
}